# Migration environment (F05.0, D-27). Installed once by deploy/setup.sh as
# /etc/wip/migrate.env, mode 0600, owner root:root, never overwritten. Read only by
# deploy/deploy.sh, as root, around `alembic upgrade head`; the API and the worker
# never see it (F02.1). Two names and nothing else.
# Migration role (owns the schema): app_owner on the Managed Postgres cluster, PRIVATE
# hostname, sslmode=require, database "wip". Shape:
#   postgresql+psycopg://app_owner:PASSWORD@private-HOST:25060/wip?sslmode=require
DATABASE_OWNER_URL=
# alembic/env.py reads this from the process environment (not from a settings file),
# so it is here as well as in app.env: a downgrade against the production database
# name is refused before connecting. Migrations in production are forward-only.
PROTECTED_DATABASE_NAMES=wip
