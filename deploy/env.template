# Production environment for the API and the worker (F05.0, D-27).
# Installed once by deploy/setup.sh as /etc/wip/app.env, mode 0600, owner wip:wip, and
# never overwritten; the owner fills the blanks on the server. Every name .env.example
# declares is here in the same order, with the production value where it is not a
# secret and a blank where it is (tests/test_deploy.py keeps the two files in step).
# Absent on purpose: DATABASE_OWNER_URL (it is /etc/wip/migrate.env's; the API and the
# worker never hold it) and the development-only TEST_DATABASE_URL,
# TEST_DATABASE_OWNER_URL, POSTGRES_HOST_PORT and LOCAL_OBJECT_STORE_DIR.
# Application role (no BYPASSRLS, not table owner): app_rw on the Managed Postgres
# cluster, through its PRIVATE hostname, sslmode=require, database "wip". Shape:
#   postgresql+psycopg://app_rw:PASSWORD@private-HOST:25060/wip?sslmode=require
DATABASE_URL=

# F02 · application-layer encryption (app/core/crypto.py). Generate the production key
# ON THE SERVER and paste it here; it never leaves the server or appears in chat:
#   python3 -c "import os,base64;print('prod1:'+base64.b64encode(os.urandom(32)).decode())"
# Format: key_id:base64key[,key_id:base64key…]. Rotate by adding a key and moving the active id.
CRYPTO_KEYS=
CRYPTO_ACTIVE_KEY_ID=prod1
# Sessions: idle and absolute limits, cookie flags. Always Secure behind TLS.
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
SESSION_TOUCH_SECONDS=60
SESSION_COOKIE_SECURE=true
# Base of the React app: prefix of one-time activation links, and the only origin
# allowed to make state-changing browser requests (F02.1).
APP_BASE_URL=https://jobcost.dev
# F02.1 · activation links (D-16) and the enrolment-only session they open.
ACTIVATION_LINK_TTL_HOURS=72
ENROL_SESSION_TTL_MINUTES=15
# F02.1 · per-IP throttle on login, TOTP verify/recover and link redemption.
IP_THROTTLE_FAILURES=20
IP_THROTTLE_MINUTES=15
# Reverse proxies in front of the API: exactly one, nginx on this droplet, which SETS
# X-Forwarded-For to the address it saw (docs/OPERATIONS.md, "Production").
TRUSTED_PROXY_COUNT=1
# Path of this file at runtime (systemd passes it as EnvironmentFile as well).
ENV_FILE=/etc/wip/app.env

# F03 · object storage (D-21): the private Space. The five SPACES_* variables have no
# defaults; the API and worker exit at start-up naming any that is missing. The key id
# and secret come from the Space's access key (the owner pastes them here).
OBJECT_STORE=s3
SPACES_ENDPOINT_URL=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=jobcost-files
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
# Lifetime of a signed download URL and the upload size limit (nginx's
# client_max_body_size in deploy/nginx/jobcost.dev.conf equals this).
SIGNED_URL_TTL_SECONDS=60
MAX_UPLOAD_BYTES=26214400
# F03 · worker (D-19). Poll interval (LISTEN/NOTIFY wakes it earlier), task lease,
# attempts and backoff (base × 2^(attempt−1), capped). See docs/OPERATIONS.md.
WORKER_POLL_SECONDS=5
WORKER_LEASE_SECONDS=300
TASK_MAX_ATTEMPTS=5
TASK_BACKOFF_BASE_SECONDS=30
TASK_BACKOFF_CAP_SECONDS=900
# Destructive-downgrade guard: the production database name. Migrations in production
# are forward-only; a downgrade against this name is refused before connecting.
PROTECTED_DATABASE_NAMES=wip

# F05 · QuickBooks Online. Development keys and the sandbox company until F05.1 (D-25).
# The redirect URI is registered on the Intuit app, character for character.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox
QBO_REDIRECT_URI=https://jobcost.dev/api/qbo/callback
# Minutes between change polls once a company is connected.
QBO_CDC_POLL_MINUTES=15
