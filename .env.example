# Copy to .env for local development. Values match db/init/01_roles.sh defaults.
# Application role (no BYPASSRLS, not table owner)
DATABASE_URL=postgresql+psycopg://app_rw:app_rw_dev@localhost:5433/wip
# Migration role (owns the schema). Used only by Alembic.
DATABASE_OWNER_URL=postgresql+psycopg://app_owner:app_owner_dev@localhost:5433/wip
# Test suite (pytest) uses a separate database
TEST_DATABASE_URL=postgresql+psycopg://app_rw:app_rw_dev@localhost:5433/wip_test
TEST_DATABASE_OWNER_URL=postgresql+psycopg://app_owner:app_owner_dev@localhost:5433/wip_test

# F02 · application-layer encryption (app/core/crypto.py). No key material lives in this
# file or anywhere in the repo. Generate one key per environment with:  python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Format: key_id:base64key[,key_id:base64key…]. Rotate by adding a key and moving the active id.
CRYPTO_KEYS=dev1:<base64 of 32 random bytes; see command above>
CRYPTO_ACTIVE_KEY_ID=dev1
# Sessions: idle and absolute limits, cookie flags. SESSION_COOKIE_SECURE=false only for a
# browser that refuses Secure cookies on http://localhost (Chrome and Firefox accept them).
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
SESSION_COOKIE_SECURE=true
# Base of the React app, used to build one-time password-reset links.
APP_BASE_URL=http://localhost:5173
# Host port for the compose Postgres (docker-compose.yml).
POSTGRES_HOST_PORT=5433
